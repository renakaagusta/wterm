{
  "name": "local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "mkdir -p public && cp node_modules/@wterm/core/wasm/wterm.wasm public/wterm.wasm && chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null; true",
    "dev": "concurrently -k -n server,vite -c cyan,green \"tsx server.ts\" \"vite\"",
    "build": "vite build",
    "preview": "tsx server.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@wterm/core": "workspace:*",
    "@wterm/dom": "workspace:*",
    "@wterm/react": "workspace:*",
    "concurrently": "^9.1.2",
    "lucide-react": "^1.8.0",
    "node-pty": "^1.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "vite": "^6.3.5",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  }
}
