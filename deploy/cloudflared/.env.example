# ─── Required: shell user & host paths ────────────────────────────────────────

# Username the in-container shell runs as. On macOS this should match your
# host user so bind-mounted files retain their ownership.
SHELL_USER=youruser

# Optional: override UID/GID if 1000:1000 collides with another account.
# SHELL_UID=1000
# SHELL_GID=1000

# Absolute path of the host home directory that gets bind-mounted into the
# container (so `cd ~` inside the terminal lands in your real home).
HOST_HOME=/Users/youruser

# Absolute path to your local clone of github.com/<you>/appctl.
# Bind-mounted read-only at /opt/appctl inside the container.
APPCTL_HOST_PATH=/Users/youruser/Documents/project/appctl

# ─── Required: auth ───────────────────────────────────────────────────────────

# Password required to log in to the terminal UI.
WTERM_PASSWORD=change-me

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
TOKEN_SECRET=change-me

# ─── Required: Cloudflare tunnel ──────────────────────────────────────────────

# Absolute path to the tunnel ingress config (copy from cloudflared-config.example.yml).
CLOUDFLARED_CONFIG=/Users/youruser/Documents/project/wterm/deploy/cloudflared/cloudflared-config.yml

# Absolute path to the tunnel credentials JSON written by `cloudflared tunnel create`.
CLOUDFLARED_CREDENTIALS=/Users/youruser/.cloudflared/your-tunnel-id.json

# ─── Optional ─────────────────────────────────────────────────────────────────

# Host port the wterm UI binds to (loopback only). Default: 3021
# WTERM_HOST_PORT=3021

# Shared secret for the appctl HTTP bridge, if used.
# BRIDGE_SECRET=

# GitHub token exposed to in-terminal `gh` CLI (optional).
# GH_TOKEN=

# Public URL of an openvscode-server, if you run one. Shown in the UI.
# VSCODE_URL=https://code.example.com

# Path-prefix rewrite for VS Code "open" links: HOST_PATH:CONTAINER_PATH
# Example: /Users/youruser/Documents/project:/home/project
# VSCODE_PATH_MAP=
