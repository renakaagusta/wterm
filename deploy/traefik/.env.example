# ─── Required: routing ───────────────────────────────────────────────────────

# Public hostname Traefik should route to wterm.
WTERM_HOST=terminal.example.com

# ─── Required: auth ──────────────────────────────────────────────────────────

# Password required to log in to the terminal UI.
WTERM_PASSWORD=change-me

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
TOKEN_SECRET=change-me

# ─── Optional: traefik wiring ────────────────────────────────────────────────

# External Docker network Traefik watches. Default: traefik
# TRAEFIK_NETWORK=traefik

# Traefik entrypoint to attach the router to. Default: websecure
# TRAEFIK_ENTRYPOINT=websecure

# Cert resolver name configured in Traefik. Default: letsencrypt
# TRAEFIK_CERTRESOLVER=letsencrypt

# ─── Optional: container shell user ──────────────────────────────────────────

# Username, UID, GID and home dir for the in-container shell.
# Defaults: wterm / 1000 / 1000 / /home/wterm
# SHELL_USER=wterm
# SHELL_UID=1000
# SHELL_GID=1000
# SHELL_HOME=/home/wterm

# ─── Optional ────────────────────────────────────────────────────────────────

# Shared secret for the appctl HTTP bridge, if used.
# BRIDGE_SECRET=

# GitHub token exposed to in-terminal `gh` CLI (optional).
# GH_TOKEN=

# Public URL of an openvscode-server, if you run one. Shown in the UI.
# VSCODE_URL=https://code.example.com

# Path-prefix rewrite for VS Code "open" links: HOST_PATH:CONTAINER_PATH
# VSCODE_PATH_MAP=
